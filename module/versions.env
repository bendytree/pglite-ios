# Pinned inputs for the pglite.wasi module build. Every external artifact
# is fetched by build.sh into module/cache/ and verified against the
# sha256 recorded here; the Docker build itself never touches the network.
#
# Pins and recipe derived from moznion/wasipg (Apache-2.0); see NOTICE.

# electric-sql/postgres-pglite, branch REL_17_5_WASM-pglite ("sync",
# 2025-07-31): pre-patched PostgreSQL 17.5 with the in-tree WASI builder.
# The fork's newer branches (REL_18_3-pglite) have no WASI support.
PGLITE_REPO=https://github.com/electric-sql/postgres-pglite
PGLITE_REF=2194acf356e9b7bf7cff29c4ed4bd6b82b93895d

# electric-sql/portable-sdk release pinned by the branch's .buildconfig.
SDK_VERSION=3.1.74.12.0
SDK_SHA256_AARCH64=ae5be6198935ca67bba69eb80a1ad6e9fcca4f32bc1c993bdf41026700c49a50
SDK_SHA256_X86_64=__FILLED_BY_FIRST_BUILD__

# wasi-sdk overlay: LLVM 22's sjlj lowering emits standardized exnref
# exception handling (required for PostgreSQL error recovery).
WASI_SDK_OVERLAY_VERSION=33.0
WASI_SDK_OVERLAY_TAG=wasi-sdk-33
WASI_SDK_OVERLAY_SHA256_AARCH64=4f98ee738c7abb45c81a94d1461fc53cc569d1cd01498951c8184d841a027844
WASI_SDK_OVERLAY_SHA256_X86_64=__FILLED_BY_FIRST_BUILD__

# pgvector, statically linked into the module.
PGVECTOR_VERSION=0.8.0
PGVECTOR_SHA256=867a2c328d4928a5a9d6f052cd3bc78c7d60228a9b914ad32aa3db88e9de27b0
